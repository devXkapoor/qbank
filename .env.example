# --- Database ---
# Local Postgres or a hosted one (Neon, Supabase, Railway).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/qbank

# --- Auth ---
# Any long random string. Generate one: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string

# --- Anthropic ---
ANTHROPIC_API_KEY=sk-ant-...
# Model IDs are pinned snapshots and change over time. As of Aug 2026,
# claude-sonnet-4-6 is a solid default for generation. Newer options:
# claude-sonnet-5, claude-opus-4-8. Verify current IDs at:
# https://docs.claude.com/en/docs/about-claude/models/overview
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Server ---
PORT=3000
